---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    title: 'Building cellar: a support agent that checks its own work',
    date: 'October 2026',
    href: '/writing/building-cellar',
    summary:
      'How I built an AI support agent on my own GPUs, and what I found: a perfect score that was a lie, an agent that claimed actions it never took, and why fine-tuning beat prompting the same model.',
  },
];
---

<BaseLayout title="Writing" description="Write-ups by Riiny Giir on what I build and what I find.">
  <section class="mx-auto max-w-3xl py-24 text-center sm:py-32" aria-labelledby="writing-title">
    <h1 id="writing-title" class="text-6xl font-semibold leading-[0.95] tracking-tight sm:text-7xl">
      Writing
      <span class="font-display block italic text-[0.92em] text-[var(--color-muted-foreground)] dark:text-[var(--color-muted-foreground-on-dark)]">
        what I build and what I find
      </span>
    </h1>
  </section>

  <section class="mx-auto max-w-3xl pb-24" aria-label="Posts">
    <ul class="grid gap-4">
      {posts.map((p) => (
        <li>
          <a
            href={p.href}
            class="block rounded-3xl border border-[var(--color-border)] bg-[var(--color-muted-surface)] p-8 text-inherit hover:no-underline dark:border-[var(--color-border-on-dark)] dark:bg-[color-mix(in_srgb,var(--color-foreground)_88%,white_12%)]"
          >
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)] dark:text-[var(--color-muted-foreground-on-dark)]">{p.date}</p>
            <h2 class="mt-3 text-xl font-semibold text-[var(--color-foreground)] dark:text-[var(--color-background)]">{p.title}</h2>
            <p class="mt-3 leading-relaxed text-[var(--color-muted-foreground)] dark:text-[var(--color-muted-foreground-on-dark)]">{p.summary}</p>
            <p class="mt-5 text-sm font-medium text-[var(--color-accent)]">Read the write-up ›</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
